---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostPreview from '../components/PostPreview.astro';

const labs = (await getCollection('lab')).sort(
    (a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf()
);
---

<BaseLayout
    title="Lab"
    description="Laboratorios prácticos de SQL, PL/SQL y MongoDB."
    showHeader={false}
>
    <h1 class="mb-12 text-2xl leading-tight font-serif italic sm:mb-16 sm:text-4xl">Lab</h1>
    {labs.map((lab) => <PostPreview post={lab} basePath="/lab" class="mb-10 sm:mb-12" />)}
</BaseLayout>
